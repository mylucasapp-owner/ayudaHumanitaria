{
  "name": "ayuda-humanitaria",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:emu": "NEXT_PUBLIC_USE_EMULATORS=1 next dev --port 3001",
    "emulators": "firebase emulators:start --only auth,firestore",
    "test": "firebase emulators:exec --only auth,firestore,functions \"node --experimental-strip-types --import ./tests/register.mjs --test 'tests/*.test.mjs'\"",
    "test:unit": "node --experimental-strip-types --import ./tests/register.mjs --test tests/unit.test.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "rm -rf .next/types && tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "deploy": "npm run check && next build && firebase deploy",
    "lint": "eslint app components lib",
    "humo": "node scripts/humo.mjs",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "firebase": "^11.0.0",
    "leaflet": "^1.9.4",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright-core": "^1.62.1",
    "typescript": "^5.6.0"
  }
}

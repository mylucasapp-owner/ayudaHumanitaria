# Config web de Firebase (Consola > Configuracion del proyecto > Tus apps > Web).
# Estos valores viajan al navegador por diseno; la seguridad real vive en firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# App Check (reCAPTCHA Enterprise). Sin esto la atestacion queda apagada.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Proveedor de teselas. Sin esto se usa OpenStreetMap, cuya politica de uso no
# cubre picos masivos y cuyo estilo es blanco (mala lectura al sol y mas bateria).
#
# Stadia Maps, estilo oscuro, autenticando por dominio (sin llave en el bundle):
#   https://tiles.stadiamaps.com/tiles/alidade_smooth_dark/{z}/{x}/{y}.png
# Si prefieres autenticar por llave, agregale:  ?api_key=TU_LLAVE
#
# Alternativa de contraste extremo, util a pleno sol:
#   https://tiles.stadiamaps.com/tiles/stamen_toner/{z}/{x}/{y}.png
NEXT_PUBLIC_TILE_URL=
NEXT_PUBLIC_TILE_ATTRIBUTION=
NEXT_PUBLIC_TILE_MAX_ZOOM=
# Invertir las teselas por CSS. Solo si el proveedor entrega mapa CLARO:
# sobre un estilo ya oscuro lo devolveria a blanco.
NEXT_PUBLIC_TILE_DARK_FILTER=

# URL de una plataforma aliada, con su token, para traer sus ofertas.
# Opcional: sin esto la app funciona igual, solo no importa datos de nadie.
# Es una credencial y por eso vive aquí y no en el repositorio.
SOCIO_URL=
